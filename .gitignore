# Public release allowlist: only original scanner source and docs are tracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/CHANGELOG.md
!/scanner/
!/docs/
!/tools/
!/examples/

/scanner/*
!/scanner/index.js
!/scanner/package.json
!/scanner/sensitivity_lexicon.json

/docs/*
!/docs/ARCHITECTURE.md
!/docs/DSR_AUDIT_STATUS.md

/tools/*

/examples/*
!/examples/sample-inventory.csv

# Never publish local game files, generated inventories, saves, or outputs.
/.work/
/adapters/
/text_inventory.csv
*.dcx
*.bnd
*.bnd3
*.emevd
*.sl2
*.sav
*.dll
*.exe
